<?xml version="1.0"?>
<launch>

  <arg name="port" default="5555" />
  <arg name="host" default="192.168.0.100" />
  <arg name="frame" default="hydrabox_link" />
  <arg name="validate" default="false" />

  <arg name="gnss_topic" default="/agribot/gnss/hydrabox" />
  <arg name="heading_topic" default="/agribot/heading/hydrabox" />
  <arg name="imu_topic" default="/agribot/imu/hydrabox" />
  <arg name="mag_topic" default="/agribot/mag/hydrabox" />

  <node name="hydrabox_gnss_driver" pkg="hydrabox_gnss_driver" type="hydrabox.py" output="screen">
    <param name="port" value="$(arg port)" />
    <param name="host" value="$(arg host)" />
    <param name="frame" value="$(arg frame)" />
    <param name="validate" value="$(arg validate)" />

    <remap from="gps/data" to="$(arg gnss_topic)" />
    <remap from="gps/heading" to="$(arg heading_topic)" />
    <remap from="imu/data" to="$(arg imu_topic)" />
    <remap from="imu/mag" to="$(arg mag_topic)" />
  </node>

</launch>
